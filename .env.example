# ==============================================================================
# VAULT PLATFORM CONFIGURATION & ENVIRONMENT SPECIFICATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (SvelteKit & Vite)
# ------------------------------------------------------------------------------
# Active port for the unified SvelteKit frontend server (default: 5173)
PORT=5173

# Node execution environment: 'development' | 'production'
NODE_ENV=development

# Canonical origin for the frontend application
ORIGIN=http://localhost:5173

# Secret for frontend session / cookie encryption (if SSR session cookies enabled)
VAULT_SECRET=change-this-to-a-secure-random-32-char-string


# ------------------------------------------------------------------------------
# 2. LOCAL KIOSK SERVER & DROP HUB (server.py - default port: 8443)
# ------------------------------------------------------------------------------
# Directory where server database, encryption keys, and staging workspaces reside
VAULT_SERVER_DATA_DIR=./data_server

# Password pepper for Argon2id credential hashing (HMAC-SHA256 pre-hash)
# If omitted, auto-generated and safely stored at ./data_server/server_pepper.key
# VAULT_PASSWORD_PEPPER=your-secure-32-byte-hex-or-base64-pepper

# Main VPS / Domain Endpoint (default: vault.laddu.cc)
SERVERIP=vault.laddu.cc

# Public or tunnel URL advertised for customer mobile uploads
# (e.g. https://vault.laddu.cc or http://localhost:8443)
VAULT_TUNNEL_URL=https://vault.laddu.cc

# Vanity domain for customer portal links (e.g. vault.laddu.cc)
VAULT_VANITY_DOMAIN=vault.laddu.cc

# Optional Cloudflare Tunnel Token for automatic tunnel start
# VAULT_TUNNEL_TOKEN=eyJhIjoi...
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...


# ------------------------------------------------------------------------------
# 3. CENTRAL MANAGER & FLEET NOTARY (manager.py - default port: 8000)
# ------------------------------------------------------------------------------
# Path to SQLite database file for manager fleet metadata
VAULT_MANAGER_DB=manager.db

# Storage path for digitally signed OTA firmware / OS update images
VAULT_RELEASES_DIR=manager_releases

# Local hub URL for transparent reverse proxying of cafe traffic
VAULT_LOCAL_HUB_URL=http://localhost:8443

# Optional: Master Ed25519 signing key override (URL-safe base64 encoded private key)
# If omitted, manager auto-generates a persistent keypair in the database
# VAULT_MANAGER_SIGNING_KEY=your-base64-ed25519-private-key
